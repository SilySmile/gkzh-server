<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gkzh.wjyd.mapper.BizQuestionMapper">
    
    <resultMap type="BizQuestion" id="BizQuestionResult">
        <result property="id"    column="id"    />
        <result property="questionText"    column="question_text"    />
        <result property="questionImage"    column="question_image"    />
        <result property="optionA"    column="option_a"    />
        <result property="optionB"    column="option_b"    />
        <result property="optionC"    column="option_c"    />
        <result property="correctOptionKey"    column="correct_option_key"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectBizQuestionVo">
        select id, question_text, question_image, option_a, option_b, option_c, correct_option_key, status, create_by, create_time, update_by, update_time, remark from biz_question
    </sql>

    <select id="selectBizQuestionList" parameterType="BizQuestion" resultMap="BizQuestionResult">
        <include refid="selectBizQuestionVo"/>
        <where>  
            <if test="questionText != null  and questionText != ''"> and question_text like concat('%', #{questionText}, '%')</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectBizQuestionById" parameterType="Long" resultMap="BizQuestionResult">
        <include refid="selectBizQuestionVo"/>
        where id = #{id}
    </select>

    <insert id="insertBizQuestion" parameterType="BizQuestion" useGeneratedKeys="true" keyProperty="id">
        insert into biz_question
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="questionText != null and questionText != ''">question_text,</if>
            <if test="questionImage != null">question_image,</if>
            <if test="optionA != null and optionA != ''">option_a,</if>
            <if test="optionB != null and optionB != ''">option_b,</if>
            <if test="optionC != null and optionC != ''">option_c,</if>
            <if test="correctOptionKey != null and correctOptionKey != ''">correct_option_key,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="questionText != null and questionText != ''">#{questionText},</if>
            <if test="questionImage != null">#{questionImage},</if>
            <if test="optionA != null and optionA != ''">#{optionA},</if>
            <if test="optionB != null and optionB != ''">#{optionB},</if>
            <if test="optionC != null and optionC != ''">#{optionC},</if>
            <if test="correctOptionKey != null and correctOptionKey != ''">#{correctOptionKey},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateBizQuestion" parameterType="BizQuestion">
        update biz_question
        <trim prefix="SET" suffixOverrides=",">
            <if test="questionText != null and questionText != ''">question_text = #{questionText},</if>
            <if test="questionImage != null">question_image = #{questionImage},</if>
            <if test="optionA != null and optionA != ''">option_a = #{optionA},</if>
            <if test="optionB != null and optionB != ''">option_b = #{optionB},</if>
            <if test="optionC != null and optionC != ''">option_c = #{optionC},</if>
            <if test="correctOptionKey != null and correctOptionKey != ''">correct_option_key = #{correctOptionKey},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteBizQuestionById" parameterType="Long">
        delete from biz_question where id = #{id}
    </delete>

    <delete id="deleteBizQuestionByIds" parameterType="String">
        delete from biz_question where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="selectUserAnswerRecordsForExport" resultType="com.gkzh.wjyd.vo.UserAnswerRecordVO">
        SELECT
            bgr.user_id as userId,
            su.user_name as userName,
            su.nick_name as nickName,
            bq.question_text as questionText,
            bq.option_a as optionA,
            bq.option_b as optionB,
            bq.option_c as optionC,
            bad.user_answer as userAnswer,
            CASE
                WHEN bad.is_correct = 1 THEN '正确'
                ELSE '错误'
                END as isCorrect,
            DATE_FORMAT(bgr.create_time, '%Y-%m-%d %H:%i:%s') as answerTime
        FROM biz_answer_detail bad
                 JOIN biz_game_round bgr ON bad.round_id = bgr.id
                 JOIN biz_question bq ON bad.question_id = bq.id
                 LEFT JOIN sys_user su ON bgr.user_id = su.user_id
        ORDER BY bgr.user_id, bgr.create_time, bad.id
    </select>

    <select id="selectUserAnswerRecordsForExport2" parameterType="com.gkzh.wjyd.dto.GameRoundQueryDTO" resultType="com.gkzh.wjyd.vo.UserAnswerRecordVO">
        SELECT
        bgr.user_id as userId,
        su.user_name as userName,
        su.nick_name as nickName,
        bad.user_answer as userAnswer,
        bad.question_id as questionId,
        CASE
        WHEN bad.is_correct = 1 THEN '正确'
        ELSE '错误'
        END as isCorrect,
        DATE_FORMAT(bgr.create_time, '%Y-%m-%d %H:%i:%s') as answerTime
        FROM biz_game_round bgr
        JOIN biz_answer_detail bad ON bad.round_id = bgr.id
        LEFT JOIN sys_user su ON bgr.user_id = su.user_id
        <where>
            <if test="isSuccess != null and isSuccess != ''">
                AND bgr.is_success = #{isSuccess}
            </if>
            <if test="startTime != null">
                AND bgr.create_time &gt;= #{startTime}
            </if>
            <if test="endTime != null">
                AND bgr.create_time &lt;= #{endTime}
            </if>
            <if test="username != null and username != ''">
                AND su.user_name LIKE CONCAT('%', #{username}, '%')
            </if>
            <if test="nickname != null and nickname != ''">
                AND su.nick_name LIKE CONCAT('%', #{nickname}, '%')
            </if>
        </where>
        ORDER BY bgr.create_time DESC, bgr.user_id, bad.id
    </select>
</mapper>
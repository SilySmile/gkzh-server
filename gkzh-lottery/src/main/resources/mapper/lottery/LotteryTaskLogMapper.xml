<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gkzh.lottery.mapper.LotteryTaskLogMapper">
    
    <resultMap type="LotteryTaskLog" id="LotteryTaskLogResult">
        <result property="logId"    column="log_id"    />
        <result property="userId"    column="user_id"    />
        <result property="userName"    column="user_name"    />
        <result property="activityId"    column="activity_id"    />
        <result property="activityTitle"    column="activity_title"    />
        <result property="taskId"    column="task_id"    />
        <result property="taskTitle"    column="task_title"    />
        <result property="completedAt"    column="completed_at"    />
        <result property="extraData"    column="extra_data"    />
    </resultMap>

    <sql id="selectLotteryTaskLogVo">
        select l.log_id, l.user_id, u.user_name, l.activity_id, a.title as activity_title, 
               l.task_id, t.title as task_title, l.completed_at, l.extra_data 
        from lottery_task_log l
        left join sys_user u on l.user_id = u.user_id
        left join lottery_activity a on l.activity_id = a.activity_id
        left join lottery_task t on l.task_id = t.task_id
    </sql>

    <select id="selectLotteryTaskLogList" parameterType="LotteryTaskLog" resultMap="LotteryTaskLogResult">
        <include refid="selectLotteryTaskLogVo"/>
        <where>  
            <if test="userId != null "> and l.user_id = #{userId}</if>
            <if test="userName != null and userName != ''"> and u.user_name like concat('%', #{userName}, '%')</if>
            <if test="activityId != null "> and l.activity_id = #{activityId}</if>
            <if test="activityTitle != null and activityTitle != ''"> and a.title like concat('%', #{activityTitle}, '%')</if>
            <if test="completedAt != null "> and l.completed_at = #{completedAt}</if>
            <if test="extraData != null  and extraData != ''"> and l.extra_data = #{extraData}</if>
        </where>
        order by l.completed_at desc
    </select>
    
    <select id="selectLotteryTaskLogByLogId" parameterType="Long" resultMap="LotteryTaskLogResult">
        <include refid="selectLotteryTaskLogVo"/>
        where l.log_id = #{logId}
    </select>

    <insert id="insertLotteryTaskLog" parameterType="LotteryTaskLog" useGeneratedKeys="true" keyProperty="logId">
        insert into lottery_task_log
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="activityId != null">activity_id,</if>
            <if test="taskId != null">task_id,</if>
            <if test="completedAt != null">completed_at,</if>
            <if test="extraData != null">extra_data,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="activityId != null">#{activityId},</if>
            <if test="taskId != null">#{taskId},</if>
            <if test="completedAt != null">#{completedAt},</if>
            <if test="extraData != null">#{extraData},</if>
         </trim>
    </insert>

    <update id="updateLotteryTaskLog" parameterType="LotteryTaskLog">
        update lottery_task_log
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="activityId != null">activity_id = #{activityId},</if>
            <if test="taskId != null">task_id = #{taskId},</if>
            <if test="completedAt != null">completed_at = #{completedAt},</if>
            <if test="extraData != null">extra_data = #{extraData},</if>
        </trim>
        where log_id = #{logId}
    </update>

    <delete id="deleteLotteryTaskLogByLogId" parameterType="Long">
        delete from lottery_task_log where log_id = #{logId}
    </delete>

    <delete id="deleteLotteryTaskLogByLogIds" parameterType="String">
        delete from lottery_task_log where log_id in 
        <foreach item="logId" collection="array" open="(" separator="," close=")">
            #{logId}
        </foreach>
    </delete>
</mapper>